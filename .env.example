# Resend — klucz API (Sending access) dla tej strony.
# Tworzy się go w Resend → API Keys. Nigdy nie wrzucaj do frontendu (bez NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxx

# Adres, na który Resend dostarcza wiadomości z formularza.
# Tu: Twój prywatny Gmail (burguntoy@gmail.com).
CONTACT_EMAIL=burguntoy@gmail.com

# Adres nadawcy ("From") widoczny w wiadomości.
# Domyślnie (gdy zmienna nieustawiona) używany jest onboarding@resend.dev,
# który działa bez weryfikacji domeny — wystarcza do testów.
# Po weryfikacji domeny jakubadamski.pl w Resend → Domains ustaw:
# CONTACT_FROM=Jakub Adamski <kontakt@jakubadamski.pl>
# CONTACT_FROM=Jakub Adamski <onboarding@resend.dev>
